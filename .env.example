# Public site
NEXT_PUBLIC_SITE_URL=https://harrisonwarburton.com

# Postgres. Local: `docker compose up -d db`. Production: Neon connection string.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# Optional: higher GitHub API rate limits for contribution graph + repo bootleg
GITHUB_TOKEN=

# Clerk (required for /admin, /sign-in, /sign-up)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# First admin access: comma-separated emails and/or set publicMetadata.role=admin in Clerk
ADMIN_EMAILS=me@harrisonwarburton.com

# Optional AI replies on /hire
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sprint 6 — time tracking invoices
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: emailed when you send an invoice (PDF attached). Skip either to keep checkout-only.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Harrison Warburton <billing@harrisonwarburton.com>
