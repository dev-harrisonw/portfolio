generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  body        String    @default("")
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  service   String?
  timeline  String?
  budget    String?
  details   String?
  summary   String?
  createdAt DateTime @default(now())
}

// ─── Time tracking (Sprint 6). Money is stored in minor units (pence). ───

enum RolloverPolicy {
  EXPIRE
  ROLLOVER
  ROLLOVER_CAPPED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// TIME = hours (retainer allowance or pay-as-you-go). FIXED = fixed-price build shown as progress.
enum ProjectBillingType {
  TIME
  FIXED
}

enum PaymentTerms {
  FIFTY_FIFTY
  UPFRONT
  ON_COMPLETION
  FORTY_THIRTY_THIRTY
  CUSTOM
}

enum StageStatus {
  PENDING
  DUE
  INVOICED
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Client {
  id               String         @id @default(cuid())
  name             String
  billingEmail     String
  currency         String         @default("GBP")
  hourlyRate       Int
  /// Retainer allowance per period; null = pay-as-you-go.
  monthlyHours     Int?
  /// Fixed retainer fee per period; null = bill allowance hours at hourlyRate.
  retainerAmount   Int?
  /// Day of month the billing period starts (1–28).
  periodStartDay   Int            @default(1)
  rolloverPolicy   RolloverPolicy @default(EXPIRE)
  rolloverCapHours Int?
  /// Round each entry up to this many minutes when invoicing (0 = exact).
  roundingMinutes  Int            @default(0)
  /// Basis points, e.g. 2000 = 20%. 0 = not VAT-registered.
  vatRateBps       Int            @default(0)
  reviewBeforeSend Boolean        @default(false)
  stripeCustomerId String?
  archived         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  users    ClientUser[]
  projects Project[]
  carries  AllowanceCarry[]
  invoices Invoice[]
}

model ClientUser {
  id          String   @id @default(cuid())
  clientId    String
  email       String
  /// Null until the invited user signs up and is linked.
  clerkUserId String?  @unique
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([email])
}

model Project {
  id               String          @id @default(cuid())
  clientId         String
  name             String
  status           ProjectStatus   @default(ACTIVE)
  /// Overrides the client's hourly rate when set.
  hourlyRate       Int?
  /// A project-level allowance; when set, rollover settings below override the client's.
  monthlyHours     Int?
  rolloverPolicy   RolloverPolicy?
  rolloverCapHours Int?
  billingType      ProjectBillingType @default(TIME)
  /// FIXED only: agreed price, payment terms, dates, and an optional manual progress % (0–100).
  fixedPrice       Int?
  paymentTerms     PaymentTerms?
  startDate        DateTime?
  dueDate          DateTime?
  progressOverride Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client  Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks   Task[]
  carries AllowanceCarry[]
  stages  PaymentStage[]
  invoices Invoice[]

  @@index([clientId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@index([projectId])
  @@index([completedAt])
}

model TimeEntry {
  id              String    @id @default(cuid())
  taskId          String
  startedAt       DateTime
  /// Null while the timer is running. Only one running entry is allowed (enforced in lib/time).
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  note            String    @default("")
  billable        Boolean   @default(true)
  invoiceId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([invoiceId])
}

/// A fixed-price payment stage (e.g. 50% deposit). Invoiced when marked reached.
model PaymentStage {
  id        String      @id @default(cuid())
  projectId String
  label     String
  percent   Int
  sortOrder Int         @default(0)
  status    StageStatus @default(PENDING)
  reachedAt DateTime?
  invoiceId String?     @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

/// Unused hours carried into a period, snapshotted when the previous period closes.
model AllowanceCarry {
  id             String   @id @default(cuid())
  clientId       String?
  projectId      String?
  periodStart    DateTime
  carriedMinutes Int
  createdAt      DateTime @default(now())

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, periodStart])
  @@unique([projectId, periodStart])
}

enum InvoiceKind {
  PERIOD
  STAGE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Invoice {
  id                      String        @id @default(cuid())
  clientId                String
  number                  String        @unique
  kind                    InvoiceKind
  status                  InvoiceStatus @default(DRAFT)
  /// PERIOD invoices: the billing window. STAGE invoices leave these null.
  periodStart             DateTime?
  periodEnd               DateTime?
  projectId               String?
  currency                String
  subtotal                Int
  vatRateBps              Int
  vat                     Int
  total                   Int
  dueAt                   DateTime?
  sentAt                  DateTime?
  paidAt                  DateTime?
  stripeCheckoutSessionId String?       @unique
  checkoutUrl             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines   InvoiceLine[]
  entries TimeEntry[]
  stages  PaymentStage[]

  @@index([clientId])
  @@index([status])
  @@index([periodStart])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  projectId   String?
  description String
  minutes     Int     @default(0)
  rate        Int     @default(0)
  amount      Int
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
